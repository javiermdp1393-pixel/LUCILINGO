# Lucilingo — variables de entorno
# Copia este archivo a .env.local y rellena la service_role key.

# --- Supabase (proyecto "Lucilingo") ---
# URL del proyecto (público).
SUPABASE_URL=https://ojqwxibpklmnzdrsjlsi.supabase.co

# service_role key (SECRETA — solo servidor, nunca en el cliente).
# Cópiala del dashboard: Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# --- Puerta de acceso ---
# Contraseña única para entrar a la app. Si no se define, por defecto es "LUCIMIV".
# Cámbiala aquí (y en Vercel) cuando quieras, sin tocar código.
APP_PASSWORD=LUCIMIV

# --- IA (F2+) ---
# Clave de Anthropic para generación de variantes de ejercicios (solo servidor).
# Consola de Anthropic → API Keys. Añádela también en Vercel.
ANTHROPIC_API_KEY=

# --- Notion (F5, sync del Mistake log) ---
# Token de una integración interna de Notion con acceso al Mistake log (solo servidor).
# notion.so/my-integrations → New integration → copia el "Internal Integration Secret",
# y comparte la base "Mistake log" con la integración.
NOTION_TOKEN=
# ID de la base (opcional; por defecto usa el Mistake log ya conocido).
# NOTION_DATABASE_ID=14458520-60d9-4d9d-b387-516c60e26101

# --- Latido para que Supabase no pause el proyecto ---
# El plan gratuito de Supabase pausa los proyectos con poca actividad en 7 días.
# vercel.json programa un cron diario a /api/cron/keepalive que hace unas
# lecturas baratas para que el proyecto cuente como activo.
#
# OPCIONAL y con un orden importante: define esta variable en Vercel SOLO
# después de comprobar que el cron se ejecuta bien. Mientras no exista, la ruta
# responde a cualquiera (no devuelve datos, solo un ok); en cuanto exista, exige
# la cabecera «Authorization: Bearer <CRON_SECRET>», que es la que Vercel manda
# en sus crons. Al revés te arriesgas a que el latido falle en silencio y el
# proyecto se pause igual.
# CRON_SECRET=
