# Lucilingo — variables de entorno
# Copia este archivo a .env.local y rellena la service_role key.

# --- Supabase (proyecto "Lucilingo") ---
# URL del proyecto (público).
SUPABASE_URL=https://ojqwxibpklmnzdrsjlsi.supabase.co

# service_role key (SECRETA — solo servidor, nunca en el cliente).
# Cópiala del dashboard: Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# --- Puerta de acceso ---
# Contraseña única para entrar a la app. Si no se define, por defecto es "LUCIMIV".
# Cámbiala aquí (y en Vercel) cuando quieras, sin tocar código.
APP_PASSWORD=LUCIMIV

# --- IA (F2+) ---
# Clave de Anthropic para generación de variantes de ejercicios (solo servidor).
# Consola de Anthropic → API Keys. Añádela también en Vercel.
ANTHROPIC_API_KEY=
